{
  "rules": [
    {
      "id": "act-click-upgrade",
      "purpose": "act",
      "when": {
        "stepText": "the customer clicks the upgrade button"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Upgrade to Pro",
                "within": "Plan"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-confirm-upgrade",
      "purpose": "act",
      "when": {
        "stepText": "the customer confirms the upgrade"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Confirm",
                "within": "Confirm upgrade"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-upgrade-to-pro",
      "purpose": "act",
      "when": {
        "stepText": "the customer upgrades to Pro"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Upgrade to Pro",
                "within": "Plan"
              }
            }
          },
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Confirm",
                "within": "Confirm upgrade"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-open-billing",
      "purpose": "act",
      "when": {
        "stepText": "the customer opens the billing page from the navigation"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "link",
                "name": "Billing",
                "within": "Primary"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-click-downgrade",
      "purpose": "act",
      "when": {
        "stepText": "the customer clicks the downgrade button"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Downgrade to Free",
                "within": "Plan"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-add-todo",
      "purpose": "act",
      "when": {
        "stepText": "the customer adds a todo titled Buy milk"
      },
      "respond": {
        "script": [
          {
            "tool": "fill",
            "args": {
              "target": {
                "role": "textbox",
                "name": "New todo"
              },
              "param": "title"
            }
          },
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Add"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-submit-form",
      "description": "Deliberately ambiguous: two Submit buttons, no section named in the step text (R-AG2).",
      "purpose": "act",
      "when": {
        "stepText": "the customer submits the form"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Submit"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-shipping-street",
      "purpose": "act",
      "when": {
        "stepText": "the customer types 12 Main Street into the street field of the Shipping section"
      },
      "respond": {
        "script": [
          {
            "tool": "fill",
            "args": {
              "target": {
                "role": "textbox",
                "name": "Street",
                "within": "Shipping"
              },
              "param": "street"
            }
          }
        ]
      }
    },
    {
      "id": "act-submit-shipping",
      "purpose": "act",
      "when": {
        "stepText": "the customer submits the Shipping section"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Submit",
                "within": "Shipping"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-login-email",
      "purpose": "act",
      "when": {
        "stepText": "the administrator types admin@acme.example into the email field"
      },
      "respond": {
        "script": [
          {
            "tool": "fill",
            "args": {
              "target": {
                "role": "textbox",
                "name": "Email"
              },
              "param": "email"
            }
          }
        ]
      }
    },
    {
      "id": "act-login-password",
      "purpose": "act",
      "when": {
        "stepText": "the administrator types <secret:adminPassword> into the password field"
      },
      "respond": {
        "script": [
          {
            "tool": "fill",
            "args": {
              "target": {
                "role": "textbox",
                "name": "Password"
              },
              "secret": "adminPassword"
            }
          }
        ]
      }
    },
    {
      "id": "act-login-submit",
      "purpose": "act",
      "when": {
        "stepText": "the administrator presses Sign in"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Sign in"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-open-release-notes",
      "purpose": "act",
      "when": {
        "stepText": "the customer opens the release notes from the navigation"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "link",
                "name": "Release notes",
                "within": "Primary"
              }
            }
          }
        ]
      }
    }
  ]
}
