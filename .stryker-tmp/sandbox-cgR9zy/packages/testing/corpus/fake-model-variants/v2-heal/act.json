{
  "rules": [
    {
      "id": "act-v2-click-upgrade",
      "description": "Flag v2 renames the upgrade button; used to heal a recording made without the flag (M9).",
      "purpose": "act",
      "when": {
        "stepText": "the customer clicks the upgrade button"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Go Pro",
                "within": "Plan"
              }
            }
          }
        ]
      }
    },
    {
      "id": "act-v2-upgrade-to-pro",
      "purpose": "act",
      "when": {
        "stepText": "the customer upgrades to Pro"
      },
      "respond": {
        "script": [
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Go Pro",
                "within": "Plan"
              }
            }
          },
          {
            "tool": "click",
            "args": {
              "target": {
                "role": "button",
                "name": "Confirm",
                "within": "Confirm upgrade"
              }
            }
          }
        ]
      }
    }
  ]
}
