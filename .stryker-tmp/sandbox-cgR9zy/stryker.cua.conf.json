{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "dir": ".",
    "related": true
  },
  "mutate": [
    "packages/driver-cua/src/keys.ts",
    "packages/driver-cua/src/nodes.ts"
  ],
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/cua.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 20000,
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker"
  ]
}