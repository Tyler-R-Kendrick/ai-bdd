{
  "name": "ai-bdd-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint packages tests scripts",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --project unit",
    "crap": "node scripts/crap.mjs",
    "verify:accept": "node packages/verify/src/cli.ts accept",
    "verify:check": "node packages/verify/src/cli.ts check",
    "coverage": "vitest run --passWithNoTests --project unit --coverage.enabled && node scripts/coverage-report.mjs",
    "test:acceptance": "vitest run --passWithNoTests --project acceptance",
    "test:adversarial": "vitest run --passWithNoTests --project adversarial",
    "check": "node scripts/check-all.mjs",
    "test:live": "vitest run -c tests/live/vitest.live.config.ts"
  },
  "devDependencies": {
    "@ai-bdd/cli": "workspace:*",
    "@ai-bdd/driver-cua": "workspace:*",
    "@ai-bdd/driver-playwright": "workspace:*",
    "@ai-bdd/models-ai-sdk": "workspace:*",
    "@ai-bdd/playwright-test": "workspace:*",
    "@ai-bdd/sdk": "workspace:*",
    "@ai-bdd/testing": "workspace:*",
    "@ai-bdd/verify": "workspace:*",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "oxlint": "^1.87.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
