{
  "name": "@ai-bdd/e2e-host",
  "version": "0.1.0",
  "description": "Runs ai-bdd specs inside TesterArmy e2e's own runner, using only e2e's public API.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "^22.22.3 || >=24.8.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./register": { "types": "./dist/register.d.ts", "default": "./dist/register.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc -b", "typecheck": "tsc -b", "test": "vitest run", "lint": "oxlint src test" },
  "dependencies": {
    "@ai-bdd/contracts": "workspace:*",
    "@ai-bdd/lock": "workspace:*",
    "@ai-bdd/registry": "workspace:*",
    "@ai-bdd/spec-gauge": "workspace:*",
    "@ai-bdd/spec-gherkin": "workspace:*"
  },
  "peerDependencies": { "e2e": ">=0.19 <0.21" },
  "peerDependenciesMeta": { "e2e": { "optional": true } },
  "devDependencies": { "vitest": "^5.0.3" }
}
