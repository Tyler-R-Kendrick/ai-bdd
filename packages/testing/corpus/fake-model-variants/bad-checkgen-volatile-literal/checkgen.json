{
  "rules": [
    {
      "id": "bad-check-invoice-volatile",
      "description": "Deliberately bad: the literal is a date that is not in the step text (R-AS2).",
      "purpose": "checkgen",
      "when": {
        "criterion": {
          "contains": "the invoice preview shows the prorated amount"
        }
      },
      "respond": {
        "object": {
          "classification": "change",
          "predicates": [
            {
              "op": "text",
              "query": {
                "role": "paragraph",
                "within": {
                  "role": "region",
                  "name": "Invoice preview"
                }
              },
              "match": "contains",
              "value": {
                "literal": "due 2026-11-01"
              }
            }
          ]
        }
      }
    }
  ]
}
