{
  "rules": [
    {
      "id": "bad-judge-plan-pro-contradictory",
      "purpose": "judge",
      "when": {
        "criterion": {
          "contains": "the plan changes to Pro"
        }
      },
      "respond": {
        "samples": [
          {
            "probability": 0.1,
            "verdict": "holds",
            "explanation": "Contradiction: verdict holds with a low probability.",
            "observed": "Plan: Pro"
          },
          {
            "probability": 0.9,
            "verdict": "fails",
            "explanation": "Contradiction: verdict fails with a high probability.",
            "observed": "Plan: Pro"
          },
          {
            "probability": 0.1,
            "verdict": "holds",
            "explanation": "Contradiction: verdict holds with a low probability.",
            "observed": "Plan: Pro"
          }
        ]
      }
    }
  ]
}
