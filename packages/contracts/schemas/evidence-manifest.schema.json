{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "rootHash": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "ed25519"
        },
        "keyId": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "alg",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runId",
    "rootHash",
    "count",
    "createdAt"
  ],
  "additionalProperties": false
}
