{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evidenceId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "screenshot",
        "observation",
        "video",
        "judge-request",
        "judge-response",
        "action-log",
        "check-result",
        "act-program",
        "check-program",
        "log",
        "attachment",
        "tree",
        "dom"
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ext": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "ext",
        "path"
      ],
      "additionalProperties": false
    },
    "stepId": {
      "type": "string"
    },
    "scenarioId": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "spanId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "chainHash": {
      "type": "string"
    },
    "prevChainHash": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "evidenceId",
    "runId",
    "kind",
    "artifact",
    "createdAt",
    "chainHash",
    "prevChainHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
