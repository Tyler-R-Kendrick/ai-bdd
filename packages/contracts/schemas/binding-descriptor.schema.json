{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "type": "string"
    },
    "patternKind": {
      "type": "string",
      "enum": [
        "cucumber-expression",
        "regex",
        "gauge-template"
      ]
    },
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "setup",
            "action",
            "assertion"
          ]
        },
        {
          "type": "string",
          "const": "any"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterExamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "int",
              "float",
              "word",
              "any",
              "enum"
            ]
          },
          "enumValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "derived": {
            "type": "boolean"
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "strictKind": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "uri",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "functionRef": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "provider",
    "pattern",
    "patternKind",
    "kind"
  ],
  "additionalProperties": false
}
