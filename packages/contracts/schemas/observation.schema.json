{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "treeHash": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "screenshot": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ext": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sha256",
        "ext",
        "path"
      ],
      "additionalProperties": false
    },
    "tainted": {
      "type": "boolean"
    },
    "maskingProven": {
      "type": "boolean"
    },
    "settled": {
      "type": "boolean"
    },
    "capturedAt": {
      "type": "string"
    }
  },
  "required": [
    "revision",
    "nodes",
    "treeHash",
    "tainted",
    "maskingProven",
    "settled",
    "capturedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "testId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "ref",
        "role",
        "name"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
