{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "setup",
        "action",
        "assertion"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "check",
        "judge",
        "both"
      ]
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "failThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "vision": {
      "type": "boolean"
    },
    "driver": {
      "type": "string"
    },
    "resolve": {
      "type": "string",
      "enum": [
        "auto",
        "exact",
        "semantic",
        "agent"
      ]
    },
    "timeout": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "invariant": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
