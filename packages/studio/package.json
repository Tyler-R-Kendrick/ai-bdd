{
  "name": "@ai-bdd/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && esbuild server/main.ts server/mcp.ts server/machine-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:contracts": "vitest run --config vitest.config.ts tests/pact.test.ts",
    "verify": "node --experimental-strip-types verification/check.ts",
    "mcp": "node dist/server/mcp.js",
    "mcp:dev": "tsx server/mcp.ts",
    "machine:connect": "node dist/server/machine-worker.js",
    "verify:live": "tsx server/integrations/live-check.ts"
  },
  "dependencies": {
