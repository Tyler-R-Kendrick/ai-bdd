# Copy values into deployment secret storage; never commit the populated file.
NODE_ENV=production
STUDIO_ORIGIN=https://studio.example.com
# Local single-host adapter. In Vercel select vercel and LEAVE STUDIO_PORT UNSET.
STUDIO_HOSTING_PROVIDER=node
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8787
STUDIO_DATA_DIR=/data

# Vercel runtime: secret bindings, never browser-prefixed variables.
# Set STUDIO_HOSTING_PROVIDER=vercel and configure per-environment isolated services.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
STUDIO_QUEUE_REGION=iad1
STUDIO_REQUEST_SECONDS=300
STUDIO_JOB_SECRET=
CRON_SECRET=
# VERCEL_URL/VERCEL_DEPLOYMENT_ID/VERCEL_OIDC_TOKEN and STUDIO_BACKEND_URL are
# trusted platform metadata / generated service bindings; do not hardcode them.

# Optional comma-separated IP/CIDR list for the actual reverse-proxy hops.
# Empty means no forwarded client address is trusted. Never trust all Internet IPs.
STUDIO_TRUSTED_PROXIES=

# GitHub-only sign-in automatically provisions passwordless internal users.
# No owner email, invitation or local signup is required. Existing bindings retain
# their Studio user ID and project roles.
# Preferred: the UID returned by the owned managed Vercel Connect setup.
# Attach this connector to the intended project and deployment environments.
# No GitHub client secret is required for the managed connector.
STUDIO_GITHUB_SIGNIN_CONNECTOR=
# Explicit direct OAuth adapter for deployments outside Connect. Only this
# adapter registers ${STUDIO_ORIGIN}/api/auth/github/callback at GitHub.
# Password/bootstrap/demo/organization-OIDC login is disabled, with no fallback.
STUDIO_GITHUB_SIGNIN_CLIENT_ID=
STUDIO_GITHUB_SIGNIN_CLIENT_SECRET=

# Default T3 harness: actual native MCP registration, never uploaded commands.
# Approve this native MCP client with Supervised (approval-required) access.
# PROJECT must exactly match one native project's absolute workspaceRoot.
# Mandatory for generation; native permissions/provider/project are verified before work.
STUDIO_T3_MCP_URL=
STUDIO_T3_MCP_ACCESS_TOKEN=
STUDIO_T3_PROJECT=
STUDIO_T3_PROVIDERS_JSON=
# Optional legacy metadata only. CLI-only registration is unavailable; no CLI starts.
STUDIO_T3_COMMAND=
STUDIO_T3_ARGS=

# Optional verified-free Vercel/fx alternative. No automatic fallback from T3.
# Vercel uses platform OIDC; external/local runtimes use AI_GATEWAY_API_KEY.
# Never persist a short-lived platform OIDC token.
# Only currently zero-priced catalog models and provider endpoints are admitted.
STUDIO_MODEL=
AI_GATEWAY_API_KEY=
STUDIO_GATEWAY_BASE_URL=
STUDIO_FX_MODELS_JSON=
# Independent opt-in native evaluation models; defaults stay on local CPU.
STUDIO_DECISION_EVALUATION_MODELS_JSON=

# Optional absolute path to an OPERATOR-TRUSTED ai-bdd config file.
# Mount the config read-only and install any custom driver/model packages.
STUDIO_RUNNER_CONFIG=
AI_BDD_CHROMIUM_PATH=/usr/bin/chromium

# Public PR refresh works without a token. A configured token is used only for
# exact owner/repo entries listed here; keep its permissions read-only/minimal.
STUDIO_GITHUB_TOKEN=
STUDIO_GITHUB_REPOSITORIES=
# User repository OAuth (separate consent and permissions from GitHub sign-in).
STUDIO_GITHUB_CLIENT_KIND=github-app
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
# Independent 32-byte base64url encryption key; retain securely for credential recovery.
STUDIO_REPOSITORY_TOKEN_KEY=
STUDIO_GITHUB_WEBHOOK_SECRET=

# MCP adapter only; API tokens are created under Share → Connect an agent.
STUDIO_API_URL=https://studio.example.com
STUDIO_API_TOKEN=

# The optional external-proof gate fails if any required input is absent.
STUDIO_REQUIRE_PROOF=0
STUDIO_PROOF_VERIFIER=
STUDIO_PROOF_RECEIPT=
STUDIO_PROOF_PROGRAM=
STUDIO_PROOF_INPUT=
STUDIO_PROOF_OUTPUT=
