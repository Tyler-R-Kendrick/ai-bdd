  "narrative": {
    "northStar": "The artifact leads.",
    "overview": "An operating workspace with a reading surface inside it. Persistent project navigation, a central artifact canvas, and artifact-specific discussion and evidence keep the work prominent. Self-hosted Inter, white paper, pale green-gray grounds, and restrained purple preserve the identity authorized through the user’s references.",
    "keyCharacteristics": [
      "Compact neutral chrome",
      "White authored surfaces",
      "Restrained purple selection and focus",
      "Explicit collaboration, draft, conflict, and evidence states"
    ],
    "rules": [
      {
        "name": "The readable accent rule",
        "body": "Keep focus purple and darker purple text in separate roles. Use the implemented muted and green-gray supporting text colors.",
        "section": "colors"
      },
      {
        "name": "The bounded geometry rule",
        "body": "The exact interval checker covers shell allocation at widths 320–4096px, not browser text layout, WebGL, generated content, or asynchronous behavior.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do let the artifact lead.",
      "Do preserve the darker supporting and purple text roles.",
      "Do distinguish live document connection from explicit saving.",
      "Do retain evidence version and stale-state labels.",
      "Do preserve keyboard focus, labeled icons, inert overlays, local scrolling, and reduced-motion behavior."
    ],
    "donts": [
      "Don’t use focus purple as a substitute for darker purple text.",
