{
  "name": "@ai-bdd/cucumber",
  "version": "0.1.0",
  "description": "ai-bdd plugin for cucumber-js: thin catch-all step definitions that forward to the ai-bdd daemon.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "^22.22.3 || >=24.8.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./register": { "types": "./dist/register.d.ts", "default": "./dist/register.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc -b", "typecheck": "tsc -b", "test": "vitest run", "lint": "oxlint src test" },
  "dependencies": { "@ai-bdd/contracts": "workspace:*" },
  "peerDependencies": { "@cucumber/cucumber": ">=9 <14" },
  "peerDependenciesMeta": { "@cucumber/cucumber": { "optional": true } },
  "devDependencies": {
    "vitest": "^5.0.3",
    "@ai-bdd/runtime": "workspace:*",
    "@ai-bdd/daemon": "workspace:*",
    "@ai-bdd/models": "workspace:*",
    "@ai-bdd/driver-fake": "workspace:*"
  }
}
